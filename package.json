{
  "name": "norm-local-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:audio": "node scripts/generate-audio-library.mjs",
    "predev": "npm run prepare:audio",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run prepare:audio",
    "build": "vite build",
    "prebuild:pages": "npm run prepare:audio",
    "build:pages": "vite build --base=/norm-source/site/ && node scripts/fix-pages-assets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:https-entry": "node scripts/test-https-entry-contract.mjs",
    "test:audio-policy": "node scripts/test-audio-policy-contract.mjs",
    "test:audio-library": "npm run prepare:audio && node scripts/test-audio-library-contract.mjs",
    "test:responsive": "node scripts/test-responsive-contract.mjs",
    "test:sidebar": "node scripts/test-sidebar-contract.mjs",
    "test:route-recovery": "node scripts/test-route-recovery-contract.mjs",
    "test:terminal": "node scripts/test-terminal-contract.mjs",
    "test:terminal-workstation": "node scripts/test-terminal-workstation-contract.mjs",
    "test:investigation": "node scripts/test-investigation-contract.mjs",
    "test:norm20": "node scripts/test-norm20-contract.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "^8.0.0",
    "typescript": "^5.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {}
}
